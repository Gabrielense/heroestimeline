# Scraped page cache. Large, and it's someone else's content -- the collectors
# refetch it on demand, and the extracted data in build/data/*.json is what the
# site actually needs.
build/data/wikicache/

# Python bytecode from the build scripts.
__pycache__/

# The pathspec build/commit_plan.py writes for the next commit. Rewritten every
# run, and only ever read by the git command on the line under it.
build/data/commit_paths.txt
